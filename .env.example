# Copia este archivo como .env y pon tus datos. El .env NUNCA se sube al repo.
DB_HOST=localhost
DB_NAME=aqua_sentinel
DB_USER=root
DB_PASS=

# Llave gratuita de https://aistudio.google.com (Get API key)
GEMINI_API_KEY=
# Revisa en AI Studio qué modelo Flash tienes disponible en el nivel gratuito
GEMINI_MODEL=gemini-2.5-flash

# Correo para enviar las alertas (función "alertas por correo").
# Con Gmail: activa la verificación en dos pasos en la cuenta y crea una "contraseña de aplicación";
# esa contraseña de 16 letras va en SMTP_PASS (no la contraseña normal de la cuenta).
# Si SMTP_USER se deja vacío, no se envía ningún correo y la página lo indica.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_NOMBRE=Aqua Sentinel

# Registro de cuentas. Vacía: el registro es LIBRE y cualquiera puede elegir "Administrador"
# (cómodo para la demo, riesgoso en un sistema real). Con una clave aquí, registrarse con un rol
# que no sea Ciudadano exige escribirla. Pónganla antes de publicar el enlace de la demo.
REGISTRO_CLAVE=
# "si": el ciudadano puede enviar reportes. "no": solo ve la información y recibe alertas.
CIUDADANO_PUEDE_REPORTAR=si
